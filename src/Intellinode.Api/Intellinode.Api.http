### S4 — Refresh access token (OAuth-style rotation)

# After refresh, clients MUST store the new refreshToken from the response body.

@oldRefreshToken = {{refreshToken}}

# @name agentRefresh

POST {{Intellinode.Api_HostAddress}}/api/v1/agents/auth/refresh

Content-Type: application/json



{

  "refreshToken": "{{refreshToken}}"

}



@agentToken = {{agentRefresh.response.body.accessToken}}

@refreshToken = {{agentRefresh.response.body.refreshToken}}



# Expected: 200 { "accessToken", "refreshToken", "expiresUtc", ... }



