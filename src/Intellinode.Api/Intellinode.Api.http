### Windows 802.1X Security APIs (Windows :XP only, v1)

# Prerequisite: device enrolled with MAC suffix :XP (run agent enroll above) and admin logged in (@adminToken).
# settings.settingsJson is the inner FusionX Windows_802_1x document (structXP_Data field names, no WinCELinux wrapper).
# GET current redacts cPassword as ********; writes store the real password for agent hydration at poll time.
# Task pipeline: ModuleName=Windows_802_1x, FunctionName=Now (instant) / Update (queued), signal suffix Win802_1x.
# Agent poll hydrates compact functionParameter {"settingsVersion":N} → full WinCELinux.Windows_802_1x JSON.

@win8021xMac = 00-11-22-33-44-55:XP

### Windows 802.1X — Get current by MAC (password redacted)
# @name win8021xGetCurrent
GET {{Intellinode.Api_HostAddress}}/api/v1/admin/device-config/windows-802-1x/{{win8021xMac}}
Authorization: Bearer {{adminToken}}

# Expected: 200 with data.settings.settingsJson (cPassword=********), settingsVersion, pendingApply, lastApplyStatus


### Windows 802.1X — Execute now (instant apply, PEAP wireless sample)
# @name win8021xExecuteNow
POST {{Intellinode.Api_HostAddress}}/api/v1/admin/device-config/windows-802-1x/execute-now
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "target": {
    "macAddress": "{{win8021xMac}}",
    "osType": "XP"
  },
  "settings": {
    "settingsJson": "{\"blEnable802_Authentication\":true,\"str_Authentication\":\"Microsoft: Protected EAP (PEAP)\",\"isWired\":false,\"cSSID\":\"Corp-WiFi-Enterprise\",\"cPassword\":\"user-password\",\"cUserName\":\"corp\\\\jdoe\",\"cDomain\":\"CONTOSO\",\"objTrusted_Root_Certificate_Authorities_PEAP_TLS\":[{\"thumprint\":\"AA11BB22CC33DD44EE55FF66778899AABBCCDDEEFF\"}],\"ObjList_Of_EKUs_Client_Authentication\":[{\"name\":\"Client Authentication\"}]}"
  },
  "execution": {
    "agentAction": "0",
    "scheduleType": "InstantApply"
  },
  "options": {
    "dryRun": false,
    "returnLegacySummary": true,
    "correlationId": "55555555-5555-5555-5555-555555555555"
  }
}

# Expected: 200 success=true, data.taskId, data.execution.scheduleType=InstantApply
# Task: ModuleName=Windows_802_1x, FunctionName=Now; function_parameter stores {"settingsVersion":N} only

@win8021xTaskId = {{win8021xExecuteNow.response.body.data.taskId}}
@win8021xLegacyTaskId = 1


