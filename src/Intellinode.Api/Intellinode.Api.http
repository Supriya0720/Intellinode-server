POST {{Intellinode.Api_HostAddress}}/api/v1/admin/device-config/windows-date-time/execute-now
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "target": {
    "macAddress": "{{dateTimeMac}}",
    "osType": "XP"
  },
  "settings": {
    "applyMode": "ManualDateTime",
    "currentDateLocal": "2026-06-11",
    "currentTimeLocal": "14:30"
  },
  "execution": {
    "agentAction": "0",
    "scheduleType": "InstantApply"
  },
  "options": {
    "dryRun": false,
    "returnLegacySummary": true,
    "correlationId": "11111111-1111-1111-1111-111111111111"
  }
}

# Expected: 200 success=true, data.taskId; task ModuleName=DateTime, FunctionName=Now, ExtraData={{dateTimeMac}}&DT
# functionParameter contains WinCELinux.XPDATE_TIME with DtDate/DtTime populated


@dateTimeManualTaskId = {{dateTimeExecuteNowManual.response.body.data.taskId}}


