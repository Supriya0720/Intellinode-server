### S1.1 — Unknown MAC heartbeat via auth/token stub (no enroll) → autoDiscoverFlag: "SDFT"

# Auth creates a minimal device stub; heartbeat before inventory returns SDFT.

# @name unknownMacAuth

POST {{Intellinode.Api_HostAddress}}/api/v1/agents/auth/token

Content-Type: application/json



{

  "deviceIdentity": "DE-AD-BE-EF-00-01",

  "isRegistered": 1

}



@unknownMacToken = {{unknownMacAuth.response.body.accessToken}}



POST {{Intellinode.Api_HostAddress}}/api/v1/agents/heartbeat

Content-Type: application/json

Authorization: Bearer {{unknownMacToken}}



{

  "clientStatus": "ON",

  "duration": "00:05:00",

  "dhcp": true,

  "hostName": "UNKNOWN-PC",

  "macAddress": "DE-AD-BE-EF-00-01",

  "ipAddress": "192.168.1.200",

  "communicationIpAddress": "192.168.1.200",

  "subnetMask": "255.255.255.0",

  "gateway": "192.168.1.1",

  "primaryDns": "8.8.8.8",

  "secondaryDns": "8.8.4.4",

  "primaryWins": "0.0.0.0",

  "secondaryWins": "0.0.0.0",

  "groupName": "Default",

  "shutdownAck": "",

  "loginUserName": "",

  "pollInterval": 300,

  "communicationType": "HTTP",

  "domain": "",

  "workgroup": "WORKGROUP",

  "isDomainJoined": false,

  "userName": "",

  "password": "",

  "license": "",

  "agentUpTime": "00:10:00",

  "taskId": 0,

  "agentAction": 0

}



# Expected: 200 { "autoDiscoverFlag": "SDFT", ... }



