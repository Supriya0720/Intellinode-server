### Windows Wireless Properties APIs (Windows :XP only, v1)

# Prerequisite: device enrolled with MAC suffix :XP and admin logged in (@adminToken).
# ADR-0003 Option B: compact ref in DB; agent poll returns hydrated WinCELinux.XPWirelessNetworkSecuritySettings JSON.
# ModuleName=Wireless Network Security, ExtraData signal suffix WNS, one SSID per task.
# GET list/profile redacts strNetworkKey and strNetworkPPK as ******** (write-only on read APIs).
# Multi-profile: add Corp-WiFi, ack Completed, then add Guest (module blocks second SSID while first task is pending).
# Apply history items may include profileKey, settingsVersion, and ssid (enriched from profile row or snapshot).

@wirelessMac = 00-11-22-33-44-55:XP

### Windows Wireless Properties — List profiles by MAC
# @name wirelessListProfiles
GET {{Intellinode.Api_HostAddress}}/api/v1/admin/device-config/windows-wireless-properties/{{wirelessMac}}
Authorization: Bearer {{adminToken}}

# Expected: 200 with data.profiles[]; strNetworkKey / strNetworkPPK redacted as ********


### Windows Wireless Properties — Get single profile by SSID
# @name wirelessGetProfile
GET {{Intellinode.Api_HostAddress}}/api/v1/admin/device-config/windows-wireless-properties/{{wirelessMac}}/profiles/Corp-WiFi
Authorization: Bearer {{adminToken}}

# URL-encode SSID in path if it contains spaces or special characters (e.g. Guest%20WiFi)


### Windows Wireless Properties — Execute now (Add, WPA2-Personal)
# @name wirelessExecuteNowAdd
POST {{Intellinode.Api_HostAddress}}/api/v1/admin/device-config/windows-wireless-properties/execute-now
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "target": {
    "macAddress": "{{wirelessMac}}",
    "osType": "XP"
  },
  "operation": 0,
  "profile": {
    "ssid": "Corp-WiFi",
    "networkAuthentication": "WPA2-Personal",
    "dataEncryption": "AES",
    "networkKey": "CorpWiFiKey!2024",
    "preSharedKey": "",
    "keyIndex": 1,
    "networkName": "",
    "connectWhenInRange": true,
    "connectNonBroadcasting": false
  },
  "execution": {
    "agentAction": "0",
    "scheduleType": "InstantApply"
  },
  "options": {
    "dryRun": false,
    "returnLegacySummary": true,
    "correlationId": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"
  }
}

# Expected: 200 success=true, data.taskId, data.profileKey, data.ssid=Corp-WiFi
# Task: ModuleName=Wireless Network Security, FunctionName=Now, functionParameter={"settingsVersion":N,"profileKey":K}

@wirelessTaskId = {{wirelessExecuteNowAdd.response.body.data.taskId}}
@wirelessLegacyTaskId = 1


