@Intellinode.Api_HostAddress = http://localhost:5288



### Agent bootstrap (anonymous)

GET {{Intellinode.Api_HostAddress}}/api/v1/agents/bootstrap



### Admin login

# @name adminLogin

POST {{Intellinode.Api_HostAddress}}/api/v1/admin/auth/login

Content-Type: application/json



{

  "userName": "admin",

  "password": "Admin@123"

}



@adminToken = {{adminLogin.response.body.accessToken}}



### Admin enrollment link (MAC-bound token for S2 MacMismatch test)

# @name enrollmentLinkBound

GET {{Intellinode.Api_HostAddress}}/api/v1/admin/agents/enrollment-link?macAddress=00-11-22-33-44-55

Authorization: Bearer {{adminToken}}



@enrollmentTokenBound = {{enrollmentLinkBound.response.body.token}}



### S2 — Enroll with wrong deviceIdentity (MAC-bound token) → 401 MacMismatch

POST {{Intellinode.Api_HostAddress}}/api/v1/agents/enroll

Content-Type: application/json



{

  "token": "{{enrollmentTokenBound}}",

  "deviceIdentity": "AA-BB-CC-DD-EE-FF"

}



# Expected: 401 { "error": "MacMismatch", "message": "..." }



### Admin enrollment link (fresh token for happy path)

# @name enrollmentLink

GET {{Intellinode.Api_HostAddress}}/api/v1/admin/agents/enrollment-link?macAddress=00-11-22-33-44-55

Authorization: Bearer {{adminToken}}



@enrollmentToken = {{enrollmentLink.response.body.token}}



### S2 — Agent enroll (anonymous)

# @name agentEnroll

POST {{Intellinode.Api_HostAddress}}/api/v1/agents/enroll

Content-Type: application/json



{

  "token": "{{enrollmentToken}}",

  "deviceIdentity": "00-11-22-33-44-55"

}



@agentToken = {{agentEnroll.response.body.accessToken}}

@refreshToken = {{agentEnroll.response.body.refreshToken}}



### S1.2 — Heartbeat after enroll only (no inventory) → autoDiscoverFlag: "SDFT"

# @name heartbeatPendingInventory

POST {{Intellinode.Api_HostAddress}}/api/v1/agents/heartbeat

Content-Type: application/json

Authorization: Bearer {{agentToken}}



{

  "clientStatus": "ON",

  "duration": "00:05:00",

  "dhcp": true,

  "hostName": "WORKSTATION-01",

  "macAddress": "00-11-22-33-44-55",

  "ipAddress": "192.168.1.100",

  "communicationIpAddress": "192.168.1.100",

  "subnetMask": "255.255.255.0",

  "gateway": "192.168.1.1",

  "primaryDns": "8.8.8.8",

  "secondaryDns": "8.8.4.4",

  "primaryWins": "0.0.0.0",

  "secondaryWins": "0.0.0.0",

  "groupName": "Default",

  "shutdownAck": "",

  "loginUserName": "DOMAIN\\user",

  "pollInterval": 300,

  "communicationType": "HTTP",

  "domain": "CONTOSO",

  "workgroup": "",

  "isDomainJoined": true,

  "userName": "user",

  "password": "",

  "license": "",

  "agentUpTime": "01:23:45",

  "taskId": 0,

  "agentAction": 0

}



# Expected: 200 { "autoDiscoverFlag": "SDFT", ... }



### S2 — Agent inventory with osInfo/network field promotion

# Expected device fields after upload:

#   device.os = "Windows 11"

#   device.osVersion = "23H2"

#   device.agentVersion = "2.1.0"

#   device.hostName = "WORKSTATION-01"

#   device.ipAddress = "192.168.1.100"

POST {{Intellinode.Api_HostAddress}}/api/v1/agents/inventory

Content-Type: application/json

Authorization: Bearer {{agentToken}}



{

  "hardware": { "cpu": "Intel Core i7" },

  "network": {

    "hostName": "WORKSTATION-01",

    "ipAddress": "192.168.1.100"

  },

  "osInfo": {

    "name": "Windows 11",

    "version": "23H2",

    "agentVersion": "2.1.0"

  },

  "security": {}

}



