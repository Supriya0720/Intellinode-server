{
    "ConnectionStrings": {
       // "DefaultConnection": "Host=localhost;Port=5432;Database=intellinode;Username=postgres;Password=Admin"
         "DefaultConnection": "Host=localhost;Port=5432;Database=intellinode;Username=postgres;Password=postgres"

    },
  "Jwt": {
    "Issuer": "Intellinode",
    "Audience": "IntellinodeClients",
    "SigningKey": "REPLACE_WITH_AT_LEAST_32_CHAR_SIGNING_KEY",
    "AgentTokenMinutes": 60,
    "AdminTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
    "AgentServer": {
        "ServerBaseUrl": "https://localhost:5288",
       // "ServerBaseUrl": "https://0.0.0.0:8444",
        "ApiBaseUrl": "",
        "DefaultPollIntervalSeconds": 300,
        "EnrollmentTokenValidityHours": 24
    },
  "AgentDiscovery": {
    "RequireAdminApproval": true,
    "PendingDiscoveryRetentionDays": 90,
    "AllowReDiscoveryAfterReject": true,
    "LegacyMapExistsToTwo": true
  },
  "SystemSetting": {
    "Enabled": false,
    "ReadOnly": false,
    "DualWrite": true,
    "LegacySummaryEnabled": true
  },
  "Keyboard": {
    "Enabled": true,
    "ReadOnly": false,
    "LegacySummaryEnabled": true,
    "DefaultSignalSuffix": "SCR"
  },
  "Mouse": {
    "Enabled": true,
    "ReadOnly": false,
    "LegacySummaryEnabled": true,
    "DefaultSignalSuffix": "SCR"
  },
  "Display": {
    "Enabled": true,
    "ReadOnly": false,
    "LegacySummaryEnabled": true,
    "DefaultSignalSuffix": "SCR"
  },
  "Windows8021x": {
    "Enabled": true,
    "ReadOnly": false,
    "LegacySummaryEnabled": true,
    "DefaultSignalSuffix": "Win802_1x"
  },
  "WindowsComputerName": {
    "Enabled": true,
    "ReadOnly": false,
    "LegacySummaryEnabled": true,
    "DefaultSignalSuffix": "CN"
  },
  "WindowsEthernetSetup": {
    "Enabled": true,
    "ReadOnly": false,
    "LegacySummaryEnabled": true,
    "DefaultSignalSuffix": "NT&Ethernet",
    "ValidateDuplicateIp": true
  },
  "WindowsWirelessSetup": {
    "Enabled": true,
    "ReadOnly": false,
    "LegacySummaryEnabled": true,
    "DefaultSignalSuffix": "W",
    "ValidateDuplicateIp": true,
    "RequireWirelessAdapter": false
  },
  "WindowsWirelessProperties": {
    "Enabled": true,
    "ReadOnly": false,
    "LegacySummaryEnabled": true,
    "DefaultSignalSuffix": "WNS"
  },
  "TimeAndLanguageReference": {
    "Enabled": true
  },
  "WindowsDateTime": {
    "Enabled": true,
    "ReadOnly": false,
    "LegacySummaryEnabled": true,
    "ManualDateTimeSignalSuffix": "DT",
    "TimeZoneSignalSuffix": "TZ",
    "TimeServerSignalSuffix": "TS"
  },
  "WindowsRegionLocation": {
    "Enabled": true,
    "ReadOnly": false,
    "LegacySummaryEnabled": true,
    "DefaultSignalSuffix": "RLS"
  },
  "WindowsRegionalFormat": {
    "Enabled": true,
    "ReadOnly": false,
    "LegacySummaryEnabled": true,
    "DefaultSignalSuffix": "RS"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
