{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=intellinode;Username=postgres;Password=YOUR_PASSWORD"
  },
  "Jwt": {
    "Issuer": "Intellinode",
    "Audience": "IntellinodeClients",
    "SigningKey": "REPLACE_WITH_AT_LEAST_32_CHAR_SIGNING_KEY",
    "AgentTokenMinutes": 60,
    "AdminTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "AgentServer": {
    "ServerBaseUrl": "https://localhost:5288",
    "ApiBaseUrl": "",
    "DefaultPollIntervalSeconds": 300,
    "EnrollmentTokenValidityHours": 24
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
